<?xml version="1.0" encoding="utf-8"?>
<!-- A plate from above: the rim, and the well inside it. The inner circle is
     what separates this from the progress rings every fitness app uses — a
     lone ring says nothing about what it depicts.
     The outer edge sits near 70% of the launcher mask's radius; pushed wider
     it stops reading as a shape and becomes the icon's own border, since no
     background stays visible outside it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#00000000"
        android:strokeColor="#F0E9DE"
        android:strokeWidth="4.5"
        android:pathData="M54,31 a23,23 0 1,1 0,46 a23,23 0 1,1 0,-46" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#F0E9DE"
        android:strokeWidth="2"
        android:pathData="M54,37.5 a16.5,16.5 0 1,1 0,33 a16.5,16.5 0 1,1 0,-33" />
</vector>
